# Copy to .env (all values have working defaults baked into the services — this
# file documents the knobs; nothing here is a real secret).

# Ports (defaults used by `make dev`, docker-compose, and the e2e suite's own instances)
EXECUTOR_PORT=7460
GRAPHQL_PORT=7461
AGENT_PORT=7462
WEB_PORT=7463

# Service-to-service URLs (docker-compose overrides these to service hostnames)
EXECUTOR_URL=http://localhost:7460
GRAPHQL_URL=http://localhost:7461/graphql
AGENT_URL=http://localhost:7462/agui

# DEV-ONLY auth. The "secret" is intentionally public — it exists to demonstrate
# the shape of real auth, not to secure anything. Re-mint a token any time with:
#   node scripts/mint-dev-token.mjs [sub] [email] [name]
DEV_JWT_SECRET=dev-secret-not-for-production-32b-min!
DEV_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLWRlbW8iLCJlbWFpbCI6ImRlbW9AZXhhbXBsZS5jb20iLCJuYW1lIjoiRGVtbyBVc2VyIiwiaWF0IjoxNzg3OTc4MjkzLCJleHAiOjIxMDMzMzgyOTN9.isX6kh2a1JReimbCgD9Dy5meEIpkaqnmtsr-_79_oFc

# Agent streaming delay between text deltas (ms); 0 disables (tests set 0)
AGENT_STREAM_DELAY_MS=15
